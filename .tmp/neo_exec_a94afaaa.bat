powershell -Command "$javaPaths = @('C:\Program Files\Java','C:\Program Files (x86)\Java','C:\Program Files\Eclipse Foundation','C:\Program Files\Amazon Corretto','C:\Program Files\Microsoft\jdk*'); $found = $false; foreach ($path in $javaPaths) { if (Test-Path $path) { $javac = Get-ChildItem -Path $path -Filter 'javac.exe' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1; if ($javac) { Write-Host 'Found javac at:' $javac.FullName; $found = $true; break; } } }; if (-not $found) { Write-Host 'javac not found in standard locations' }"